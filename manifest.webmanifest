{
  "name": "Tabula",
  "short_name": "Tabula",
  "description": "Planificación, agenda y evaluación para docentes.",
  "lang": "es",
  "start_url": "./#/hoy",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FAF9F5",
  "theme_color": "#FAF9F5",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Dictar a Tabula",
      "short_name": "Dictar",
      "description": "Dicta tareas, eventos, observaciones o tutorías",
      "url": "./?accion=dictar#/hoy",
      "icons": [
        {
          "src": "icons/atajo-dictar.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nueva tarea",
      "short_name": "Nueva tarea",
      "url": "./?accion=tarea#/tareas",
      "icons": [
        {
          "src": "icons/atajo-tarea.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pasar lista",
      "short_name": "Pasar lista",
      "description": "Asistencia del grupo de la clase actual",
      "url": "./?accion=lista#/grupos",
      "icons": [
        {
          "src": "icons/atajo-lista.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Códigos",
      "short_name": "Códigos",
      "url": "./#/codigos",
      "icons": [
        {
          "src": "icons/atajo-codigos.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/*",
            "text/html",
            ".html",
            ".pdf",
            ".doc",
            ".docx",
            ".odt",
            ".xls",
            ".xlsx",
            ".ppt",
            ".pptx"
          ]
        }
      ]
    }
  }
}
